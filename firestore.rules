rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Check if the user is in the admins collection
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      // Check if the user is a super admin
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super';
    }

    // Admins can be managed only by super admins
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if isSuperAdmin();
    }

    // Portfolio owner profile can be updated by admins
    match /portfolioOwner/{docId} {
      allow read: if true;
      allow get, list, create, update, delete: if isAdmin();
    }

    // Messages can be created by anyone, but only managed by admins.
    // Strict SSDLC schema, data type, and character length bounds to prevent DoS/payload bloat.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt']) 
                    && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string && request.resource.data.email.size() <= 150 && request.resource.data.email.matches('^[^@]+@[^@]+\\.[a-zA-Z]{2,}$')
                    && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 5000;
      allow read, list, update, delete: if isAdmin();
    }

    // Short links rules
    match /shortLinks/{slug} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'lastClickedAt']));

      match /clicks/{clickId} {
        allow create: if request.resource.data.keys().hasAll(['timestamp', 'deviceType', 'browser', 'os', 'country', 'city', 'referer', 'userAgent', 'isBot'])
                      && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500;
        allow read, list, update, delete: if isAdmin();
      }
    }

    // All other collections (projects, certificates, etc.) can be managed by admins
    match /{collection}/{docId} {
      allow read: if true;
      allow get, list, create, update, delete: if isAdmin() && (collection != 'admins' && collection != 'portfolioOwner' && collection != 'messages' && collection != 'shortLinks');
    }
  }
}